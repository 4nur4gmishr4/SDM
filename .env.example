# ============================================================
# SAI DARSHAN MART — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env for local development:
# cp .env.example .env
#
# For Production (Netlify):
# Go to Site settings > Environment variables and add these keys.
# ============================================================

# Supabase Project URL (From Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (From Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Store WhatsApp Contact Number (for direct order routing)
VITE_STORE_WHATSAPP_NUMBER=+91 73541 55669

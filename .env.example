# Supabase Project URL (From Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://otyojqnnwbrteknyqcpi.supabase.co

# Supabase Public Anonymous Key (From Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Required only for admin migration scripts / data seeding)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Store WhatsApp Contact Number (for direct order routing)
